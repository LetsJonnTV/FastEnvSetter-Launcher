<ui:FluentWindow x:Class="FastEnvSetter.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FastEnvSetter"
                 Icon="pack://application:,,,/icon.ico"
                 Width="1180" Height="780" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid Background="{DynamicResource ShellBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="FastEnvSetter">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Background="#66000000"
              MouseLeftButtonDown="OnPaletteBackdropClicked"
              Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
            <Border Width="560" MaxHeight="440" Margin="0,70,0,0" VerticalAlignment="Top" CornerRadius="10" Padding="10"
                    BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBox x:Name="PaletteInput" PlaceholderText="Projekt oder Befehl suchen" Icon="{ui:SymbolIcon Search24}"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnPaletteKeyDown" />
                    <ListBox Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" MaxHeight="350"
                             ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                             ItemContainerStyle="{StaticResource SoftListItem}" MouseDoubleClick="OnPaletteResultClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource Symbol}}" FontSize="18" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Navigation" Margin="8,8,0,8" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource SoftListItem}"
                     PreviewMouseLeftButtonUp="OnNavigationClicked">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource Symbol}}" FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                <ui:InfoBar Margin="24,12" VerticalAlignment="Top"
                            Title="{Binding InfoTitle}" Message="{Binding InfoMessage}"
                            Severity="{Binding InfoSeverity}" IsOpen="{Binding IsInfoOpen, Mode=TwoWay}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
