<UserControl x:Class="FastEnvSetter.App.ProjectDevelopmentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,8">
            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Laufende Aktion abbrechen"
                       Content="Abbrechen" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
            <TextBlock Text="Entwicklung" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,6"
                     Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TabControl>
            <TabItem Header="Aufgaben / Tests">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <WrapPanel Margin="0,0,0,8">
                            <ui:Button Icon="{ui:SymbolIcon Search24}" Content="Vorschläge erkennen" Command="{Binding DiscoverTasksCommand}" Margin="0,0,8,6" />
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Neue Aufgabe" Command="{Binding NewTaskCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <Expander Header="Erkannte Vorschläge" IsExpanded="True" Margin="0,0,0,12">
                            <StackPanel Margin="0,8,0,0">
                                <ComboBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" DisplayMemberPath="Name" />
                                <TextBox Text="{Binding SuggestionPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,6" />
                                <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Vorschlag mit Abhängigkeiten hinzufügen"
                                           Command="{Binding AddSuggestionCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Gespeicherte Aufgaben" Style="{StaticResource Label}" />
                        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" MaxHeight="180" MinHeight="70">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,12">
                            <ui:Button Icon="{ui:SymbolIcon Play24}" Content="Gespeicherte Aufgabe ausführen" Command="{Binding RunTaskCommand}" Margin="0,0,8,6" />
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Content="Entfernen" Command="{Binding RemoveTaskCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding HasTaskDraft, Converter={StaticResource Visible}}">
                            <TextBlock Text="Aufgabenentwurf" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="Name" Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding TaskKinds}" SelectedItem="{Binding TaskKind}" />
                            </Grid>
                            <TextBlock Text="Programm / ausführbare Datei" Style="{StaticResource Label}" Margin="0,8,0,4" />
                            <ui:TextBox Text="{Binding TaskFileName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Argumente (JSON-Array, z. B. [&quot;test&quot;, &quot;--no-build&quot;])" Style="{StaticResource Label}" Margin="0,8,0,4" TextWrapping="Wrap" />
                            <TextBox Text="{Binding TaskArguments, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Arbeitsordner (relativ zum Quellordner)" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                    <ui:TextBox Text="{Binding TaskWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Zeitlimit (Sek.)" Style="{StaticResource Label}" />
                                    <ui:TextBox Text="{Binding TaskTimeout, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ClearButtonEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Benötigt erfolgreich abgeschlossene Aufgaben" Style="{StaticResource Label}" Margin="0,8,0,4" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TaskDependencies}" ItemTemplate="{StaticResource CheckRow}" ItemsPanel="{StaticResource WrapItems}" />
                            <ui:Button Icon="{ui:SymbolIcon Save24}" Content="Aufgabe speichern" Command="{Binding SaveTaskCommand}" HorizontalAlignment="Left" Margin="0,8,0,12" />
                        </StackPanel>
                    </StackPanel>
                    <Expander Header="Ergebnisse und maskierte Logs" IsExpanded="True">
                        <TextBox Text="{Binding TaskOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" MinHeight="100" MaxHeight="280" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </TabItem>
            <TabItem Header="Env-Dateien">
                <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
                    <WrapPanel>
                        <ui:Button Icon="{ui:SymbolIcon Search24}" Content=".env-Dateien suchen" Command="{Binding DiscoverEnvironmentCommand}" Margin="0,0,8,8" />
                        <ui:Button Icon="{ui:SymbolIcon Folder24}" Content="Datei wählen" Command="{Binding ChooseEnvironmentCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="Gefundene Dateien" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding EnvironmentSuggestions}" SelectedItem="{Binding SelectedEnvironmentSuggestion}" />
                    <TextBlock Text="Relativer Dateipfad" Style="{StaticResource Label}" Margin="0,8,0,4" />
                    <ui:TextBox Text="{Binding EnvironmentPath, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Margin="0,8,0,8">
                        <ui:Button Icon="{ui:SymbolIcon Document24}" Content="Schlüsselvorschau" Command="{Binding PreviewEnvironmentCommand}" Margin="0,0,8,6" />
                        <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Als Laufzeitquelle hinzufügen" Command="{Binding AddEnvironmentCommand}" IsEnabled="{Binding CanAddEnvironment}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBox Text="{Binding EnvironmentPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="Laufzeitquellen (Reihenfolge: spätere Datei gewinnt)" Style="{StaticResource Label}" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding EnvironmentFiles}" SelectedItem="{Binding SelectedEnvironmentFile}" MinHeight="70" MaxHeight="150" />
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Content="Aus Quellen entfernen" Command="{Binding RemoveEnvironmentCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Git">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <WrapPanel>
                            <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Status laden" Command="{Binding RefreshGitCommand}" Margin="0,0,8,8" />
                            <ui:Button Icon="{ui:SymbolIcon History24}" Content="Historie laden" Command="{Binding GitHistoryCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding GitFiles}" SelectedItem="{Binding SelectedGitFile}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="100" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Index" Binding="{Binding IndexStatus}" Width="55" />
                                <DataGridTextColumn Header="Lokal" Binding="{Binding WorkTreeStatus}" Width="55" />
                                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Auswahl stagen" Command="{Binding StageCommand}" Margin="0,0,8,6" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}" Content="Auswahl unstagen" Command="{Binding UnstageCommand}" Margin="0,0,8,6" />
                            <ui:Button Icon="{ui:SymbolIcon Document24}" Content="Diff der Auswahl" Command="{Binding ShowDiffCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <CheckBox Content="Index-Diff statt lokaler Änderungen" IsChecked="{Binding ShowStagedDiff}" Margin="0,4,0,8" />
                        <ui:Button Icon="{ui:SymbolIcon Search24}" Content="Gesamten Index für Commit prüfen" Command="{Binding ReviewCommitCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    </StackPanel>
                    <TextBox Text="{Binding GitDiff, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas"
                             MinHeight="120" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding ReviewFingerprint}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,0,6" />
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <CheckBox Content="Ich habe den gesamten Index-Diff geprüft." IsChecked="{Binding ReviewAccepted}" Margin="0,0,0,8" />
                        <ui:TextBox PlaceholderText="Commit-Nachricht" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Icon="{ui:SymbolIcon Save24}" Content="Geprüften Index committen" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" HorizontalAlignment="Left" Margin="0,8,0,12" />
                    </StackPanel>
                    <Expander Header="Commit-Historie" IsExpanded="True">
                        <ListBox ItemsSource="{Binding GitHistory}" MaxHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Sha}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>