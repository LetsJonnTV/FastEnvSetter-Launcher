<UserControl x:Class="FastEnvSetter.App.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Neues Projekt"
                       Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" />
            <ui:Button DockPanel.Dock="Right" Content="Importieren" Margin="0,0,8,0"
                       Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}" />
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="0,0,8,0" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" />
            <TextBlock Text="Projekte" Style="{StaticResource PageTitle}" Margin="0,0,24,0" />
            <ui:TextBox Margin="0,0,8,0" PlaceholderText="Suchen  (Strg+K für alle Befehle)" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <ui:SymbolIcon Symbol="Rocket24" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Noch keine Projekte" Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Lege ein Projekt an und starte es danach mit einem Klick." HorizontalAlignment="Center" Style="{StaticResource Label}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Width="370" Margin="0,0,12,12" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" />
                                        <TextBlock Text="{Binding StateText}" Margin="6,0,0,0" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <Grid DockPanel.Dock="Left" Margin="-6,0,4,0">
                                        <ui:Button Appearance="Transparent" Padding="4" BorderThickness="0" Icon="{ui:SymbolIcon Star24}" ToolTip="Favorit"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource Hidden}}"
                                                   Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Padding="4" BorderThickness="0" Icon="{ui:SymbolIcon Star24, Filled=True}" ToolTip="Favorit entfernen"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource Visible}}"
                                                   Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Icons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:SymbolIcon Symbol="{Binding Converter={StaticResource Symbol}}" Margin="0,0,6,0" FontSize="16"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProfileName}" Margin="0,4,0,14" Style="{StaticResource Muted}" />
                                <DockPanel Margin="0,0,0,10" Visibility="{Binding HasSourceRoot, Converter={StaticResource Visible}}">
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Open24}" ToolTip="VS Code öffnen / Editorziel wählen"
                                               Command="{Binding DataContext.OpenEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding SourceRoot}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                </DockPanel>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Globe24}" ToolTip="Im Browser öffnen"
                                                   Visibility="{Binding HasOpenUrl, Converter={StaticResource Visible}}"
                                                   Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon TextAlignLeft24}" ToolTip="Logs"
                                                   Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Edit24}" ToolTip="Bearbeiten"
                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowExportUp24}" ToolTip="Für das Team exportieren"
                                                   Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" ToolTip="Duplizieren"
                                                   Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" ToolTip="Löschen"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Left">
                                        <ui:Button Appearance="Primary" Content="Starten" Icon="{ui:SymbolIcon Play24}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource Hidden}}"
                                                   Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Danger" Content="Stoppen" Icon="{ui:SymbolIcon Stop24}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource Visible}}"
                                                   Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
