<UserControl x:Class="FastEnvSetter.App.ProjectEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FastEnvSetter.App">
    <UserControl.Resources>
        <DataTemplate x:Key="TextField">
            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <DataTemplate x:Key="ChoiceField">
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" />
        </DataTemplate>
        <DataTemplate x:Key="EditableChoiceField">
            <ComboBox IsEditable="True" ItemsSource="{Binding Choices}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <DataTemplate x:Key="PathField">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Folder24}" ToolTip="Durchsuchen"
                           Command="{Binding BrowseCommand}" />
                <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ToggleField">
            <ui:ToggleSwitch IsChecked="{Binding BoolValue}" />
        </DataTemplate>
        <local:SettingFieldTemplateSelector x:Key="FieldSelector"
                                            Text="{StaticResource TextField}"
                                            Choice="{StaticResource ChoiceField}"
                                            EditableChoice="{StaticResource EditableChoiceField}"
                                            Path="{StaticResource PathField}"
                                            Toggle="{StaticResource ToggleField}" />
    </UserControl.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Zurück"
                       Margin="0,0,8,0" Command="{Binding BackCommand}" />
            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Starten" Icon="{ui:SymbolIcon Play24}"
                       Margin="8,0,0,0" Command="{Binding StartCommand}" />
            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Projektname" FontSize="18" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <ui:TextBox Margin="0,0,0,12" PlaceholderText="Tags, mit Komma getrennt" Icon="{ui:SymbolIcon Tag24}"
                            Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}" />

                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Environment-Variablen" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="Lege zuerst unter „Env-Profile“ ein Profil an." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasProfiles, Converter={StaticResource Hidden}}" />
                        <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource CheckRow}" ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Text="Bei gleichen Namen gewinnt das zuletzt angehakte Profil." Margin="0,2,0,0" Style="{StaticResource Muted}"
                                   Visibility="{Binding HasProfiles, Converter={StaticResource Visible}}" />
                        <Separator Margin="0,10" Visibility="{Binding Variables.Count, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Variables}" ItemTemplate="{StaticResource CheckRow}" />
                    </StackPanel>
                </ui:Card>

                <DockPanel Margin="0,0,0,10">
                    <ui:Button DockPanel.Dock="Right" Content="Dienst hinzufügen" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddServiceCommand}" />
                    <TextBlock Text="Was soll gestartet werden?" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>

                <ItemsControl x:Name="ServiceList" ItemsSource="{Binding Services}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Name" Style="{StaticResource Label}" />
                                            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Sprache / Startart" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{Binding Runners}" SelectedItem="{Binding SelectedRunner}" DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                                    Visibility="{Binding IsGroup, Converter={StaticResource Visible}}">
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Nach oben"
                                                       Command="{Binding DataContext.MoveUpCommand, ElementName=ServiceList}" CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="Nach unten"
                                                       Command="{Binding DataContext.MoveDownCommand, ElementName=ServiceList}" CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" ToolTip="Entfernen"
                                                       Command="{Binding DataContext.RemoveServiceCommand, ElementName=ServiceList}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Arbeitsordner" Margin="0,12,0,4" Style="{StaticResource Label}" />
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Folder24}" ToolTip="Durchsuchen"
                                                   Command="{Binding BrowseFolderCommand}" />
                                        <ui:TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ordner wählen, Einstellungen werden erkannt" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visible}}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="{Binding Field.Label}" Style="{StaticResource Label}" />
                                                    <ContentControl Content="{Binding}" Focusable="False" ContentTemplateSelector="{StaticResource FieldSelector}" />
                                                    <TextBlock Text="{Binding Field.Hint}" Margin="0,4,0,0" Style="{StaticResource Muted}"
                                                               Visibility="{Binding Field.Hint, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <ui:ToggleSwitch Content="In eigenem Terminal öffnen" IsChecked="{Binding UseTerminal}" IsEnabled="{Binding CanChooseOutput}" />
                                            <TextBlock Text="Eine interaktive Shell braucht immer ein eigenes Terminal." Margin="0,4,0,0" Style="{StaticResource Muted}"
                                                       Visibility="{Binding TerminalForced, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsGroup, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Danach warten (Sek.)" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Label}" />
                                            <ui:TextBox Width="80" Text="{Binding StartDelaySeconds, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                        </StackPanel>
                                    </Grid>

                                    <Expander Header="Variablen nur für diesen Dienst" Margin="0,14,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding ProfileVariables}" ItemTemplate="{StaticResource CheckRow}" ItemsPanel="{StaticResource WrapItems}" />
                                            <ItemsControl ItemsSource="{Binding ExtraVariables}" ItemTemplate="{StaticResource VariableRow}" Margin="0,8,0,0" />
                                            <ui:Button Content="Eigene Variable" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddVariableCommand}" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Start und Betrieb" Margin="0,8,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel Visibility="{Binding IsGroup, Converter={StaticResource Visible}}">
                                                <TextBlock Text="Startet erst, wenn diese Dienste bereit sind" Style="{StaticResource Label}" />
                                                <ItemsControl ItemsSource="{Binding Dependencies}" ItemTemplate="{StaticResource CheckRow}" ItemsPanel="{StaticResource WrapItems}" Margin="0,0,0,12" />
                                            </StackPanel>

                                            <TextBlock Text="Bereit, wenn" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{Binding ReadinessOptions}" SelectedIndex="{Binding ReadinessIndex}" />
                                            <Grid Margin="0,8,0,0" Visibility="{Binding HasReadiness, Converter={StaticResource Visible}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox PlaceholderText="Port, z. B. 5432" ClearButtonEnabled="False"
                                                            Text="{Binding ReadinessPort, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding IsPortReadiness, Converter={StaticResource Visible}}" />
                                                <ui:TextBox PlaceholderText="http://localhost:8000/health"
                                                            Text="{Binding ReadinessUrl, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding IsUrlReadiness, Converter={StaticResource Visible}}" />
                                                <ui:TextBox Grid.Column="2" ToolTip="Zeitlimit in Sekunden" ClearButtonEnabled="False"
                                                            Text="{Binding ReadinessTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <TextBlock Text="Vorbereitung (ein Befehl pro Zeile)" Margin="0,12,0,4" Style="{StaticResource Label}" />
                                            <TextBox AcceptsReturn="True" MinHeight="64" Text="{Binding PreStepsText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Cascadia Mono, Consolas" />

                                            <ui:ToggleSwitch Content="Bei Absturz automatisch neu starten (höchstens 3-mal in 5 Minuten)" Margin="0,12,0,0" IsChecked="{Binding AutoRestart}" />

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Vor dem Start prüfen (Ports)" Style="{StaticResource Label}" />
                                                    <ui:TextBox PlaceholderText="8000, 5432" Text="{Binding ExpectedPortsText, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Adresse für „Im Browser öffnen“" Style="{StaticResource Label}" />
                                                    <ui:TextBox PlaceholderText="http://localhost:8000" Text="{Binding OpenUrl, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock Margin="0,12,0,0" Text="{Binding CommandPreview}" FontFamily="Cascadia Mono, Consolas" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
