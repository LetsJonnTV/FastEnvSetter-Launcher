<UserControl x:Class="FastEnvSetter.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,16">
            <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Externe Zugriffe (CLI / MCP)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <CheckBox Content="Externe Konfigurationsänderungen erlauben" IsChecked="{Binding AllowExternalConfigurationChanges}" />
                <TextBlock Text="Erlaubt externen Clients, Projekte, Profile und Startbefehle zu verändern." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" />
                <CheckBox Content="Externe Aufgabenausführung erlauben" IsChecked="{Binding AllowExternalTaskExecution}" />
                <TextBlock Text="Projektbefehle laufen mit deinen Rechten und aufgelösten Umgebungswerten." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" />
                <CheckBox Content="Externe Git-Änderungen erlauben" IsChecked="{Binding AllowExternalGitChanges}" />
                <TextBlock Text="Erlaubt schreibende Git-Aktionen. Nur für vertrauenswürdige Clients freigeben." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8" />
                <TextBlock Text="{Binding PermissionError}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Darstellung" Style="{StaticResource Label}" />
                    <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Name" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Tresore" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Werte aus Tresoren werden bei jedem Start geholt und nie gespeichert. Die jeweilige CLI muss installiert sein."
                               Margin="0,4,0,8" Style="{StaticResource Muted}" />
                    <ItemsControl ItemsSource="{Binding Vaults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Status prüfen" Command="{Binding CheckCommand}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ui:TextBox Margin="0,8,0,0" PlaceholderText="https://vault.example.com"
                                                Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding UsesServerUrl, Converter={StaticResource Visible}}" />
                                    <Grid Margin="0,8,0,0" Visibility="{Binding SupportsLogin, Converter={StaticResource Visible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox PlaceholderText="E-Mail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:PasswordBox Grid.Column="2" PlaceholderText="Master-Passwort" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:TextBox Grid.Column="4" PlaceholderText="2FA-Code" ClearButtonEnabled="False" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button Grid.Column="6" Appearance="Primary" Content="Entsperren" Command="{Binding LoginCommand}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="Datenpfad" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding DataPath}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button Content="Ordner öffnen" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,10,0,0" Command="{Binding OpenDataFolderCommand}" />
                    <TextBlock Text="Geheime Werte sind an dein Windows-Konto gebunden und lassen sich auf anderen Rechnern nicht entschlüsseln." Margin="0,10,0,0" Style="{StaticResource Muted}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
