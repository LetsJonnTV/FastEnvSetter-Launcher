<UserControl x:Class="FastEnvSetter.App.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Margin="24,8,24,16">
            <DockPanel Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Right" Content="Aus Datei" Icon="{ui:SymbolIcon Folder24}" Command="{Binding InstallFromFileCommand}" />
                <TextBlock Text="Plugins" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <ui:Card Padding="12" Margin="0,0,0,12" Visibility="{Binding RestartRequired, Converter={StaticResource Visible}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Jetzt neu starten" Command="{Binding RestartCommand}" />
                    <TextBlock Text="Änderungen an Code-Plugins werden nach einem Neustart wirksam." VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Installieren" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Margin="8,0,0,0" Content="Laden"
                                   Command="{Binding InstallFromAddressCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                        <ui:TextBox PlaceholderText="ghcr.io/besitzer/plugin:1.0.0" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="Installiert" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
            <TextBlock Text="Noch keine Plugins installiert." Margin="0,0,0,12" Style="{StaticResource Muted}"
                       Visibility="{Binding HasNoPlugins, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Installed}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="14" Margin="0,0,0,8">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" ToolTip="Entfernen" Margin="8,0,0,0"
                                           Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Katalog" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
            <TextBlock Text="{Binding CatalogStatus}" Margin="0,0,0,8" Style="{StaticResource Muted}"
                       Visibility="{Binding CatalogStatus, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Catalog}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="14" Margin="0,0,0,8">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Installieren"
                                           Command="{Binding DataContext.InstallFromCatalogCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
